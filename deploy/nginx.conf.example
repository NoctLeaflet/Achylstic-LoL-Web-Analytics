# Nginx site for Achylstic on an Ubuntu VPS with PHP 8.3-FPM.
# Save as /etc/nginx/sites-available/achylstic, link it into sites-enabled,
# replace the domain and the path, then run: sudo nginx -t && sudo systemctl reload nginx
# HTTPS: sudo certbot --nginx -d achylstic.example.com  (certbot edits this file)

server {
    listen 80;
    listen [::]:80;
    server_name achylstic.example.com;

    root /var/www/achylstic/public;
    index index.php;

    charset utf-8;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    # Built assets have hashed names, so they can be cached for a long time.
    location /build/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    # Never serve dotfiles (.env!) or anything outside public/.
    location ~ /\.(?!well-known).* {
        deny all;
    }
}
