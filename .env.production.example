# Starting point for the .env on a production server (see docs/DEPLOY.md).
# Copy it to .env on the server, fill in the empty values, then run: php artisan key:generate

APP_NAME=Achylstic
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://achylstic.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Warnings and errors only; "debug" fills the disk.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Use a dedicated MySQL user, not root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=achylstic
DB_USERNAME=achylstic
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

BCRYPT_ROUNDS=12

# Riot Games API. A development key expires every 24 hours: on a server, register your product at
# developer.riotgames.com to get a key that lasts longer.
RIOT_API_KEY=
RIOT_PLATFORM=sg2
RIOT_REGION=sea
RIOT_ACCOUNT_REGION=asia

# Optional Discord webhook (keep it secret).
DISCORD_WEBHOOK_URL=

# Nightly database backup: the newest BACKUP_KEEP dumps stay in storage/app/backups.
MYSQLDUMP_PATH=mysqldump
BACKUP_KEEP=14
